# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets here.

# Which LLM backend to use.
# "ollama" = free, fully self-hosted, but slow on laptop hardware.
# "groq"   = free-tier hosted API, much faster (1-2s responses).
#            Get a free key at https://console.groq.com/keys
MODEL_PROVIDER=ollama

# Where your local Ollama server is running.
OLLAMA_BASE_URL=http://localhost:11434

# Which model Ollama should use (must be pulled locally first: `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2

# Only needed if MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Where the MCP server for company enrichment lives.
MCP_SERVER_URL=http://localhost:8100

# App environment: "development" or "production"
APP_ENV=development

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
